{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated player profile, virtual coin wallet, career stats, and notification preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the player." },
        "displayName": { "type": "string", "description": "Player display name." },
        "email": { "type": "string", "description": "Verified Google account email." },
        "publicUserId": { "type": "string", "description": "Public shareable player ID (e.g. CP-XXXXXX)." },
        "photoUrl": { "type": "string", "description": "Optional Google profile photo URL." },
        "virtualCoins": { "type": "number", "description": "Virtual demo coin balance (no monetary value)." },
        "totalGames": { "type": "number", "description": "Total games played." },
        "totalWins": { "type": "number", "description": "Total games won." },
        "totalVirtualPoints": { "type": "number", "description": "Cumulative virtual points earned." },
        "currentStreak": { "type": "number", "description": "Current winning streak." },
        "bestStreak": { "type": "number", "description": "Best winning streak achieved." },
        "lastDailyBonusDate": { "type": "string", "description": "Optional UTC ISO date of last daily virtual coin bonus." },
        "referredByCode": { "type": "string", "description": "Optional referral code applied by this player." },
        "referralCount": { "type": "number", "description": "Count of collected friend referrals." },
        "referralEarnedCoins": { "type": "number", "description": "Total virtual coins collected from referrals." },
        "notifyResults": { "type": "boolean", "description": "Whether round settlement notifications are enabled." },
        "notifyRoundClosing": { "type": "boolean", "description": "Whether round closing alerts are enabled." },
        "notifyBonuses": { "type": "boolean", "description": "Whether bonus notifications are enabled." },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"], "description": "Account status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": ["userId", "displayName", "email", "publicUserId", "virtualCoins", "totalGames", "totalWins", "totalVirtualPoints", "currentStreak", "bestStreak", "notifyResults", "notifyRoundClosing", "notifyBonuses", "accountStatus", "createdAt", "updatedAt"]
    },
    "PredictionRecord": {
      "title": "PredictionRecord",
      "description": "A player's virtual coin color prediction for a specific WinGo mode and period.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "modeId": { "type": "string", "enum": ["mode_30s", "mode_60s", "mode_3m", "mode_5m"] },
        "periodId": { "type": "string" },
        "betType": { "type": "string", "enum": ["COLOR", "NUMBER", "SIZE"] },
        "betLabel": { "type": "string" },
        "selectedColor": { "type": "string", "enum": ["RED", "GREEN", "VIOLET"] },
        "selectedDigit": { "type": "number" },
        "selectedSize": { "type": "string", "enum": ["BIG", "SMALL"] },
        "stakeCoins": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "WON", "LOST"] },
        "winningColor": { "type": "string", "enum": ["RED", "GREEN", "VIOLET"] },
        "winningDigit": { "type": "number" },
        "rewardCoins": { "type": "number" },
        "resultHash": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "modeId", "periodId", "selectedColor", "stakeCoins", "status", "rewardCoins", "createdAt", "updatedAt"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Immutable virtual coin ledger entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "txType": {
          "type": "string",
          "enum": ["WELCOME_BONUS", "DAILY_BONUS", "DEMO_REFILL", "PREDICTION_ENTRY", "PREDICTION_REWARD", "MINI_GAME_ENTRY", "MINI_GAME_REWARD", "QR_VOUCHER_REDEEM", "ADMIN_CREDIT", "ADMIN_DEBIT", "DEPOSIT_CREDIT", "WITHDRAWAL_REQUEST", "WITHDRAWAL_REFUND", "REFERRAL_BONUS"]
        },
        "amount": { "type": "number" },
        "previousBalance": { "type": "number" },
        "newBalance": { "type": "number" },
        "referenceId": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "txType", "amount", "previousBalance", "newBalance", "referenceId", "description", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app notification entry for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string", "enum": ["ROUND_RESULT", "REWARD", "DAILY_BONUS", "ANNOUNCEMENT"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "referenceId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "title", "message", "read", "createdAt", "updatedAt"]
    },
    "GameRoundRecord": {
      "title": "GameRoundRecord",
      "description": "Completed verifiable WinGo round record.",
      "type": "object",
      "properties": {
        "modeId": { "type": "string", "enum": ["mode_30s", "mode_60s", "mode_3m", "mode_5m"] },
        "periodId": { "type": "string" },
        "startTimeMs": { "type": "number" },
        "endTimeMs": { "type": "number" },
        "winningColor": { "type": "string", "enum": ["RED", "GREEN", "VIOLET"] },
        "resultDigit": { "type": "number" },
        "resultHash": { "type": "string" },
        "status": { "type": "string", "enum": ["COMPLETED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["modeId", "periodId", "startTimeMs", "endTimeMs", "winningColor", "resultDigit", "resultHash", "status", "createdAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public virtual points ranking record (no PII).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "publicUserId": { "type": "string" },
        "photoUrl": { "type": "string" },
        "totalVirtualPoints": { "type": "number" },
        "totalGames": { "type": "number" },
        "totalWins": { "type": "number" },
        "bestStreak": { "type": "number" },
        "badgeTitle": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "publicUserId", "totalVirtualPoints", "totalGames", "totalWins", "bestStreak", "badgeTitle", "createdAt", "updatedAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global Admin-managed game engine, announcement, and virtual QR settings.",
      "type": "object",
      "properties": {
        "announcementText": { "type": "string" },
        "redGreenMultiplier": { "type": "number" },
        "violetMultiplier": { "type": "number" },
        "mode30sEnabled": { "type": "boolean" },
        "mode60sEnabled": { "type": "boolean" },
        "mode3mEnabled": { "type": "boolean" },
        "mode5mEnabled": { "type": "boolean" },
        "forcedNextColor": { "type": "string", "enum": ["RED", "GREEN", "VIOLET"] },
        "forced30sDigit": { "type": "number" },
        "forced60sDigit": { "type": "number" },
        "forced3mDigit": { "type": "number" },
        "forced5mDigit": { "type": "number" },
        "forcedSpinSliceIndex": { "type": "number" },
        "adminQrLabel": { "type": "string" },
        "adminQrPayload": { "type": "string" },
        "updatedByEmail": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["announcementText", "redGreenMultiplier", "violetMultiplier", "mode30sEnabled", "mode60sEnabled", "mode3mEnabled", "mode5mEnabled", "adminQrLabel", "adminQrPayload", "updatedAt"]
    },
    "VirtualVoucher": {
      "title": "VirtualVoucher",
      "description": "Virtual coin QR gift voucher redeemable once by a player.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "coinsAmount": { "type": "number" },
        "label": { "type": "string" },
        "publicVisible": { "type": "boolean" },
        "redeemed": { "type": "boolean" },
        "redeemedByUid": { "type": "string" },
        "redeemedAt": { "type": "string", "format": "date-time" },
        "createdByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "coinsAmount", "label", "publicVisible", "redeemed", "createdByEmail", "createdAt", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Audit log of actions performed by Main Admin or Co-Admins.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorRole": { "type": "string", "enum": ["SUPER_ADMIN", "CO_ADMIN"] },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorEmail", "actorRole", "action", "details", "createdAt"]
    },
    "CoAdminInvite": {
      "title": "CoAdminInvite",
      "description": "SHA-256 hashed Co-Admin passkey created by Main Admin (document ID is SHA-256 hex of password).",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "active": { "type": "boolean" },
        "createdByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["label", "active", "createdByEmail", "createdAt", "updatedAt"]
    },
    "CoAdminGrant": {
      "title": "CoAdminGrant",
      "description": "Active Co-Admin privilege grant linked to a verified invite hash.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "label": { "type": "string" },
        "inviteHash": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "label", "inviteHash", "active", "createdAt", "updatedAt"]
    },
    "WalletRequest": {
      "title": "WalletRequest",
      "description": "User deposit (QR payment reference) or withdrawal (UPI ID / Paytm number) request verified by Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "publicUserId": { "type": "string" },
        "requestType": { "type": "string", "enum": ["DEPOSIT", "WITHDRAWAL"] },
        "amountCoins": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["QR_UPI", "UPI_ID", "PAYTM"] },
        "paymentDetails": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "VERIFIED", "REJECTED"] },
        "adminNote": { "type": "string" },
        "processedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userEmail", "publicUserId", "requestType", "amountCoins", "paymentMethod", "paymentDetails", "status", "createdAt", "updatedAt"]
    },
    "ReferralCode": {
      "title": "ReferralCode",
      "description": "Public shareable referral code mapping to a player UID (no PII).",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "ownerUid", "ownerName", "createdAt", "updatedAt"]
    },
    "ReferralClaim": {
      "title": "ReferralClaim",
      "description": "One-time referral claim record granting +500 VC welcome bonus to invitee and collectible +500 VC reward to referrer.",
      "type": "object",
      "properties": {
        "referredUid": { "type": "string" },
        "referredName": { "type": "string" },
        "referrerUid": { "type": "string" },
        "referrerCode": { "type": "string" },
        "referrerName": { "type": "string" },
        "bonusCoins": { "type": "number" },
        "referrerRewardClaimed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referredUid", "referredName", "referrerUid", "referrerCode", "referrerName", "bonusCoins", "referrerRewardClaimed", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Player profiles and virtual coin wallets."
    },
    "/users/{userId}/predictions/{predictionId}": {
      "schema": { "$ref": "#/entities/PredictionRecord" },
      "description": "User-scoped WinGo prediction records."
    },
    "/users/{userId}/wallet_transactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "User-scoped virtual coin ledger."
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User-scoped notifications."
    },
    "/game_rounds/{roundId}": {
      "schema": { "$ref": "#/entities/GameRoundRecord" },
      "description": "Shared verifiable WinGo completed round history."
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Global virtual points rankings."
    },
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Global Admin-managed app configuration (document 'global')."
    },
    "/virtual_vouchers/{voucherCode}": {
      "schema": { "$ref": "#/entities/VirtualVoucher" },
      "description": "Cloud-synced Virtual Coin QR gift vouchers."
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Audit log of Admin & Co-Admin actions."
    },
    "/co_admin_invites/{inviteHash}": {
      "schema": { "$ref": "#/entities/CoAdminInvite" },
      "description": "Hashed Co-Admin passkeys created exclusively by Main Admin."
    },
    "/co_admins/{uid}": {
      "schema": { "$ref": "#/entities/CoAdminGrant" },
      "description": "Active Co-Admin session grants bound to a valid inviteHash."
    },
    "/wallet_requests/{requestId}": {
      "schema": { "$ref": "#/entities/WalletRequest" },
      "description": "User deposit & withdrawal requests processed and verified by Main Admin or Co-Admin."
    },
    "/referral_codes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCode" },
      "description": "Exact-match shareable referral code index."
    },
    "/referrals/{referredUid}": {
      "schema": { "$ref": "#/entities/ReferralClaim" },
      "description": "One-time referral claim documents for +500 VC collection."
    }
  }
}
