rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Global Security Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'buildolive4@gmail.com';
    }

    function isActiveCoAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/co_admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/co_admins/$(request.auth.uid)).data.active == true &&
             exists(/databases/$(database)/documents/co_admin_invites/$(get(/databases/$(database)/documents/co_admins/$(request.auth.uid)).data.inviteHash)) &&
             get(/databases/$(database)/documents/co_admin_invites/$(get(/databases/$(database)/documents/co_admins/$(request.auth.uid)).data.inviteHash)).data.active == true;
    }

    function isAdmin() {
      return isSuperAdmin() || isActiveCoAdmin();
    }

    function isValidColor(color) {
      return color in ['RED', 'GREEN', 'VIOLET'];
    }

    function isValidMode(modeId) {
      return modeId in ['mode_30s', 'mode_60s', 'mode_3m', 'mode_5m'];
    }

    // ---- Validation Blueprints (Anti-Update-Gap) ----

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.email is string && data.email.size() <= 120 &&
             data.publicUserId is string && data.publicUserId.size() >= 3 && data.publicUserId.size() <= 32 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 600)) &&
             data.virtualCoins is int && data.virtualCoins >= 0 && data.virtualCoins <= 100000000 &&
             data.totalGames is int && data.totalGames >= 0 &&
             data.totalWins is int && data.totalWins >= 0 &&
             data.totalVirtualPoints is int && data.totalVirtualPoints >= 0 &&
             data.currentStreak is int && data.currentStreak >= 0 &&
             data.bestStreak is int && data.bestStreak >= 0 &&
             (!('lastDailyBonusDate' in data) || data.lastDailyBonusDate == null || (data.lastDailyBonusDate is string && data.lastDailyBonusDate.size() <= 20)) &&
             (!('referredByCode' in data) || data.referredByCode == null || (data.referredByCode is string && data.referredByCode.size() >= 3 && data.referredByCode.size() <= 32)) &&
             (!('referralCount' in data) || (data.referralCount is int && data.referralCount >= 0 && data.referralCount <= 1000000)) &&
             (!('referralEarnedCoins' in data) || (data.referralEarnedCoins is int && data.referralEarnedCoins >= 0 && data.referralEarnedCoins <= 100000000)) &&
             data.notifyResults is bool &&
             data.notifyRoundClosing is bool &&
             data.notifyBonuses is bool &&
             data.accountStatus in ['ACTIVE', 'SUSPENDED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPrediction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidMode(data.modeId) &&
             data.periodId is string && data.periodId.size() >= 4 && data.periodId.size() <= 40 &&
             (!('betType' in data) || data.betType in ['COLOR', 'NUMBER', 'SIZE']) &&
             (!('betLabel' in data) || (data.betLabel is string && data.betLabel.size() <= 40)) &&
             isValidColor(data.selectedColor) &&
             (!('selectedDigit' in data) || data.selectedDigit == null || (data.selectedDigit is int && data.selectedDigit >= 0 && data.selectedDigit <= 9)) &&
             (!('selectedSize' in data) || data.selectedSize == null || data.selectedSize in ['BIG', 'SMALL']) &&
             data.stakeCoins is int && data.stakeCoins >= 10 && data.stakeCoins <= 100000 &&
             data.status in ['PENDING', 'WON', 'LOST'] &&
             (!('winningColor' in data) || data.winningColor == null || isValidColor(data.winningColor)) &&
             (!('winningDigit' in data) || data.winningDigit == null || (data.winningDigit is int && data.winningDigit >= 0 && data.winningDigit <= 9)) &&
             data.rewardCoins is int && data.rewardCoins >= 0 && data.rewardCoins <= 1000000 &&
             (!('resultHash' in data) || data.resultHash == null || (data.resultHash is string && data.resultHash.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWalletTransaction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.txType in [
               'WELCOME_BONUS', 'DAILY_BONUS', 'DEMO_REFILL',
               'PREDICTION_ENTRY', 'PREDICTION_REWARD',
               'MINI_GAME_ENTRY', 'MINI_GAME_REWARD',
               'QR_VOUCHER_REDEEM', 'ADMIN_CREDIT', 'ADMIN_DEBIT',
               'DEPOSIT_CREDIT', 'WITHDRAWAL_REQUEST', 'WITHDRAWAL_REFUND',
               'REFERRAL_BONUS'
             ] &&
             data.amount is int && data.amount >= -1000000 && data.amount <= 1000000 &&
             data.previousBalance is int && data.previousBalance >= 0 &&
             data.newBalance is int && data.newBalance >= 0 &&
             data.referenceId is string && data.referenceId.size() <= 128 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 240 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidWalletRequest(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 60 &&
             data.userEmail is string && data.userEmail.size() <= 120 &&
             data.publicUserId is string && data.publicUserId.size() >= 3 && data.publicUserId.size() <= 32 &&
             data.requestType in ['DEPOSIT', 'WITHDRAWAL'] &&
             data.amountCoins is int && data.amountCoins >= 10 && data.amountCoins <= 500000 &&
             data.paymentMethod in ['QR_UPI', 'UPI_ID', 'PAYTM'] &&
             data.paymentDetails is string && data.paymentDetails.size() >= 3 && data.paymentDetails.size() <= 160 &&
             data.status in ['PENDING', 'APPROVED', 'VERIFIED', 'REJECTED'] &&
             (!('adminNote' in data) || data.adminNote == null || (data.adminNote is string && data.adminNote.size() <= 200)) &&
             (!('processedByEmail' in data) || data.processedByEmail == null || (data.processedByEmail is string && data.processedByEmail.size() <= 120)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.category in ['ROUND_RESULT', 'REWARD', 'DAILY_BONUS', 'ANNOUNCEMENT'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
             (!('referenceId' in data) || data.referenceId == null || (data.referenceId is string && data.referenceId.size() <= 128)) &&
             data.read is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidGameRound(data) {
      return isValidMode(data.modeId) &&
             data.periodId is string && data.periodId.size() >= 4 && data.periodId.size() <= 40 &&
             data.startTimeMs is int && data.startTimeMs > 0 &&
             data.endTimeMs is int && data.endTimeMs > data.startTimeMs &&
             isValidColor(data.winningColor) &&
             data.resultDigit is int && data.resultDigit >= 0 && data.resultDigit <= 9 &&
             data.resultHash is string && data.resultHash.size() >= 16 && data.resultHash.size() <= 128 &&
             data.status == 'COMPLETED' &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.publicUserId is string && data.publicUserId.size() >= 3 && data.publicUserId.size() <= 32 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 600)) &&
             data.totalVirtualPoints is int && data.totalVirtualPoints >= 0 &&
             data.totalGames is int && data.totalGames >= 0 &&
             data.totalWins is int && data.totalWins >= 0 &&
             data.bestStreak is int && data.bestStreak >= 0 &&
             data.badgeTitle is string && data.badgeTitle.size() >= 1 && data.badgeTitle.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidForcedDigit(val) {
      return val == null || (val is int && val >= 0 && val <= 9);
    }

    function isValidAppConfig(data) {
      return data.announcementText is string && data.announcementText.size() >= 1 && data.announcementText.size() <= 240 &&
             data.redGreenMultiplier is number && data.redGreenMultiplier >= 1.1 && data.redGreenMultiplier <= 5.0 &&
             data.violetMultiplier is number && data.violetMultiplier >= 2.0 && data.violetMultiplier <= 10.0 &&
             data.mode30sEnabled is bool &&
             data.mode60sEnabled is bool &&
             data.mode3mEnabled is bool &&
             data.mode5mEnabled is bool &&
             (!('forcedNextColor' in data) || data.forcedNextColor == null || isValidColor(data.forcedNextColor)) &&
             (!('forced30sDigit' in data) || isValidForcedDigit(data.forced30sDigit)) &&
             (!('forced60sDigit' in data) || isValidForcedDigit(data.forced60sDigit)) &&
             (!('forced3mDigit' in data) || isValidForcedDigit(data.forced3mDigit)) &&
             (!('forced5mDigit' in data) || isValidForcedDigit(data.forced5mDigit)) &&
             (!('forcedSpinSliceIndex' in data) || data.forcedSpinSliceIndex == null || (data.forcedSpinSliceIndex is int && data.forcedSpinSliceIndex >= 0 && data.forcedSpinSliceIndex <= 7)) &&
             data.adminQrLabel is string && data.adminQrLabel.size() >= 1 && data.adminQrLabel.size() <= 80 &&
             data.adminQrPayload is string && data.adminQrPayload.size() >= 3 && data.adminQrPayload.size() <= 200 &&
             (!('updatedByEmail' in data) || data.updatedByEmail == null || (data.updatedByEmail is string && data.updatedByEmail.size() <= 120)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVirtualVoucher(data) {
      return data.code is string && data.code.size() >= 4 && data.code.size() <= 40 && data.code.matches('^[A-Z0-9\\-]+$') &&
             data.coinsAmount is int && data.coinsAmount >= 50 && data.coinsAmount <= 50000 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
             data.publicVisible is bool &&
             data.redeemed is bool &&
             (!('redeemedByUid' in data) || data.redeemedByUid == null || (data.redeemedByUid is string && data.redeemedByUid.size() <= 128)) &&
             (!('redeemedAt' in data) || data.redeemedAt == null || (data.redeemedAt is timestamp && data.redeemedAt <= request.time)) &&
             data.createdByEmail is string && data.createdByEmail.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminAuditLog(data) {
      return data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
             data.actorEmail is string && data.actorEmail.size() <= 120 &&
             data.actorRole in ['SUPER_ADMIN', 'CO_ADMIN'] &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 60 &&
             data.details is string && data.details.size() >= 1 && data.details.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidCoAdminInvite(data) {
      return data.label is string && data.label.size() >= 1 && data.label.size() <= 60 &&
             data.active is bool &&
             data.createdByEmail is string && data.createdByEmail.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCoAdminGrant(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 60 &&
             data.inviteHash is string && data.inviteHash.size() == 64 && data.inviteHash.matches('^[a-f0-9]+$') &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // ---- Users & User-Scoped Subcollections ----
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().accountStatus == 'ACTIVE' &&
                       incoming().virtualCoins == 2500 &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email', 'publicUserId', 'virtualCoins',
                         'totalGames', 'totalWins', 'totalVirtualPoints', 'currentStreak', 'bestStreak',
                         'notifyResults', 'notifyRoundClosing', 'notifyBonuses', 'accountStatus',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'publicUserId', 'photoUrl', 'virtualCoins',
                         'totalGames', 'totalWins', 'totalVirtualPoints', 'currentStreak', 'bestStreak',
                         'lastDailyBonusDate', 'referredByCode', 'referralCount', 'referralEarnedCoins',
                         'notifyResults', 'notifyRoundClosing', 'notifyBonuses',
                         'accountStatus', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Admin/Co-Admin can adjust virtual coins or account status
                         (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
                           'virtualCoins', 'accountStatus', 'updatedAt'
                         ])) ||
                         // Owner gameplay, profile settings, referral collection, and bonus updates
                         (isOwner(userId) && incoming().accountStatus == existing().accountStatus &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'photoUrl', 'virtualCoins', 'totalGames', 'totalWins',
                             'totalVirtualPoints', 'currentStreak', 'bestStreak', 'lastDailyBonusDate',
                             'referredByCode', 'referralCount', 'referralEarnedCoins',
                             'notifyResults', 'notifyRoundClosing', 'notifyBonuses', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if false;

      match /predictions/{predictionId} {
        allow get: if isValidId(userId) && isValidId(predictionId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId) &&
                         isValidId(userId) && isValidId(predictionId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().status == 'PENDING' &&
                         incoming().rewardCoins == 0 &&
                         incoming().keys().hasAll([
                           'userId', 'modeId', 'periodId', 'selectedColor', 'stakeCoins',
                           'status', 'rewardCoins', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'modeId', 'periodId', 'betType', 'betLabel',
                           'selectedColor', 'selectedDigit', 'selectedSize', 'stakeCoins',
                           'status', 'winningColor', 'winningDigit', 'rewardCoins', 'resultHash',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidPrediction(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) && isValidId(predictionId) &&
                         isValidPrediction(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().modeId == existing().modeId &&
                         incoming().periodId == existing().periodId &&
                         incoming().selectedColor == existing().selectedColor &&
                         incoming().stakeCoins == existing().stakeCoins &&
                         incoming().createdAt == existing().createdAt && (
                           isAdmin() ||
                           (
                             isOwner(userId) &&
                             existing().status == 'PENDING' &&
                             incoming().status in ['WON', 'LOST'] &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status', 'winningColor', 'winningDigit', 'rewardCoins', 'resultHash', 'updatedAt'
                             ])
                           )
                         );

        allow delete: if false;
      }

      match /wallet_transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isSignedIn() &&
                         isValidId(userId) && isValidId(txId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll([
                           'userId', 'txType', 'amount', 'previousBalance', 'newBalance',
                           'referenceId', 'description', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'txType', 'amount', 'previousBalance', 'newBalance',
                           'referenceId', 'description', 'createdAt'
                         ]) &&
                         isValidWalletTransaction(incoming()) && (
                           isAdmin() ||
                           (isOwner(userId) && !(incoming().txType in ['ADMIN_CREDIT', 'ADMIN_DEBIT', 'DEPOSIT_CREDIT', 'WITHDRAWAL_REFUND']))
                         );

        allow update, delete: if false;
      }

      match /notifications/{notifId} {
        allow get: if isValidId(userId) && isValidId(notifId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isSignedIn() &&
                         isValidId(userId) && isValidId(notifId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll([
                           'userId', 'category', 'title', 'message', 'read', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'category', 'title', 'message', 'referenceId', 'read', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidNotification(incoming()) &&
                         (isOwner(userId) || isAdmin());

        allow update: if isSignedIn() &&
                         isValidId(userId) && isValidId(notifId) &&
                         isValidNotification(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           isAdmin() ||
                           (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']))
                         );

        allow delete: if isValidId(userId) && isValidId(notifId) && (isOwner(userId) || isAdmin());
      }
    }

    // ---- Shared Verifiable Game Rounds ----
    match /game_rounds/{roundId} {
      allow get: if isSignedIn() && isValidId(roundId);
      allow list: if isSignedIn() && resource.data.status == 'COMPLETED';

      allow create: if isSignedIn() &&
                       isValidId(roundId) &&
                       incoming().keys().hasAll([
                         'modeId', 'periodId', 'startTimeMs', 'endTimeMs',
                         'winningColor', 'resultDigit', 'resultHash', 'status', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'modeId', 'periodId', 'startTimeMs', 'endTimeMs',
                         'winningColor', 'resultDigit', 'resultHash', 'status', 'createdAt'
                       ]) &&
                       isValidGameRound(incoming());

      allow update: if isAdmin() && isValidId(roundId) && isValidGameRound(incoming());
      allow delete: if isSuperAdmin() && isValidId(roundId);
    }

    // ---- Global Leaderboard (Public Non-PII Rankings) ----
    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.totalVirtualPoints >= 0;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       (isOwner(userId) || isAdmin()) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'publicUserId', 'totalVirtualPoints',
                         'totalGames', 'totalWins', 'bestStreak', 'badgeTitle', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'publicUserId', 'photoUrl', 'totalVirtualPoints',
                         'totalGames', 'totalWins', 'bestStreak', 'badgeTitle', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'photoUrl', 'totalVirtualPoints', 'totalGames',
                           'totalWins', 'bestStreak', 'badgeTitle', 'updatedAt'
                         ]))
                       );

      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // ---- Global App Config (Read by signed-in users, Written ONLY by Main Admin / Co-Admin) ----
    match /app_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if false;

      allow create: if isAdmin() &&
                       isValidId(configId) &&
                       incoming().keys().hasAll([
                         'announcementText', 'redGreenMultiplier', 'violetMultiplier',
                         'mode30sEnabled', 'mode60sEnabled', 'mode3mEnabled', 'mode5mEnabled',
                         'adminQrLabel', 'adminQrPayload', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'announcementText', 'redGreenMultiplier', 'violetMultiplier',
                         'mode30sEnabled', 'mode60sEnabled', 'mode3mEnabled', 'mode5mEnabled',
                         'forcedNextColor', 'forced30sDigit', 'forced60sDigit', 'forced3mDigit',
                         'forced5mDigit', 'forcedSpinSliceIndex',
                         'adminQrLabel', 'adminQrPayload', 'updatedByEmail', 'updatedAt'
                       ]) &&
                       isValidAppConfig(incoming());

      allow update: if isAdmin() &&
                       isValidId(configId) &&
                       isValidAppConfig(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'announcementText', 'redGreenMultiplier', 'violetMultiplier',
                         'mode30sEnabled', 'mode60sEnabled', 'mode3mEnabled', 'mode5mEnabled',
                         'forcedNextColor', 'forced30sDigit', 'forced60sDigit', 'forced3mDigit',
                         'forced5mDigit', 'forcedSpinSliceIndex',
                         'adminQrLabel', 'adminQrPayload', 'updatedByEmail', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // ---- Virtual QR Gift Vouchers ----
    match /virtual_vouchers/{voucherCode} {
      allow get: if isSignedIn() && isValidId(voucherCode);
      allow list: if isAdmin() || (isSignedIn() && resource.data.publicVisible == true);

      allow create: if isAdmin() &&
                       isValidId(voucherCode) &&
                       incoming().code == voucherCode &&
                       incoming().redeemed == false &&
                       incoming().keys().hasAll([
                         'code', 'coinsAmount', 'label', 'publicVisible', 'redeemed',
                         'createdByEmail', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'code', 'coinsAmount', 'label', 'publicVisible', 'redeemed',
                         'redeemedByUid', 'redeemedAt', 'createdByEmail', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidVirtualVoucher(incoming());

      allow update: if isSignedIn() &&
                       isValidId(voucherCode) &&
                       isValidVirtualVoucher(incoming()) &&
                       incoming().code == existing().code &&
                       incoming().coinsAmount == existing().coinsAmount &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           existing().redeemed == false &&
                           incoming().redeemed == true &&
                           incoming().redeemedByUid == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'redeemed', 'redeemedByUid', 'redeemedAt', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isAdmin() && isValidId(voucherCode);
    }

    // ---- Admin & Co-Admin Audit Trail ----
    match /admin_audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
                       isValidId(logId) &&
                       incoming().actorUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'actorUid', 'actorEmail', 'actorRole', 'action', 'details', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'actorUid', 'actorEmail', 'actorRole', 'action', 'details', 'createdAt'
                       ]) &&
                       isValidAdminAuditLog(incoming());

      allow update, delete: if false;
    }

    // ---- Co-Admin Passkey Invites (Main Admin creates/revokes; signed-in user verifies exact SHA-256 hash) ----
    match /co_admin_invites/{inviteHash} {
      allow get: if isSignedIn() && isValidId(inviteHash);
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() &&
                       inviteHash.size() == 64 && inviteHash.matches('^[a-f0-9]+$') &&
                       incoming().keys().hasAll(['label', 'active', 'createdByEmail', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['label', 'active', 'createdByEmail', 'createdAt', 'updatedAt']) &&
                       isValidCoAdminInvite(incoming());

      allow update: if isSuperAdmin() &&
                       inviteHash.size() == 64 && inviteHash.matches('^[a-f0-9]+$') &&
                       isValidCoAdminInvite(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['label', 'active', 'updatedAt']);

      allow delete: if isSuperAdmin() && isValidId(inviteHash);
    }

    // ---- Active Co-Admin Grants (Self-claimed ONLY with active verified inviteHash; revocable instantly by Main Admin) ----
    match /co_admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if isSignedIn() &&
                       isValidId(uid) &&
                       incoming().userId == uid &&
                       incoming().keys().hasAll([
                         'userId', 'email', 'displayName', 'label', 'inviteHash', 'active', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'displayName', 'label', 'inviteHash', 'active', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCoAdminGrant(incoming()) && (
                         isSuperAdmin() ||
                         (
                           isOwner(uid) &&
                           incoming().active == true &&
                           exists(/databases/$(database)/documents/co_admin_invites/$(incoming().inviteHash)) &&
                           get(/databases/$(database)/documents/co_admin_invites/$(incoming().inviteHash)).data.active == true
                         )
                       );

      allow update: if isSignedIn() &&
                       isValidId(uid) &&
                       isValidCoAdminGrant(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isSuperAdmin() ||
                         (
                           isOwner(uid) &&
                           incoming().active == true &&
                           exists(/databases/$(database)/documents/co_admin_invites/$(incoming().inviteHash)) &&
                           get(/databases/$(database)/documents/co_admin_invites/$(incoming().inviteHash)).data.active == true &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'label', 'inviteHash', 'active', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isValidId(uid) && (isSuperAdmin() || isOwner(uid));
    }

    // ---- Deposit & Withdrawal Requests (User creates PENDING; ONLY Admin / Co-Admin approves, verifies, or rejects) ----
    match /wallet_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll([
                         'userId', 'userName', 'userEmail', 'publicUserId',
                         'requestType', 'amountCoins', 'paymentMethod', 'paymentDetails',
                         'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'userName', 'userEmail', 'publicUserId',
                         'requestType', 'amountCoins', 'paymentMethod', 'paymentDetails',
                         'status', 'adminNote', 'processedByEmail', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidWalletRequest(incoming());

      allow update: if isAdmin() &&
                       isValidId(requestId) &&
                       isValidWalletRequest(incoming()) &&
                       existing().status == 'PENDING' &&
                       incoming().status in ['APPROVED', 'VERIFIED', 'REJECTED'] &&
                       incoming().userId == existing().userId &&
                       incoming().requestType == existing().requestType &&
                       incoming().amountCoins == existing().amountCoins &&
                       incoming().paymentMethod == existing().paymentMethod &&
                       incoming().paymentDetails == existing().paymentDetails &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'adminNote', 'processedByEmail', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // ---- Shareable Referral Code Index (Exact-code lookup, no PII list) ----
    function isValidReferralCode(data) {
      return data.code is string && data.code.size() >= 3 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9\\-]+$') &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 60 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /referral_codes/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(code) &&
                       incoming().code == code &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll(['code', 'ownerUid', 'ownerName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['code', 'ownerUid', 'ownerName', 'createdAt', 'updatedAt']) &&
                       isValidReferralCode(incoming());

      allow update: if isSignedIn() &&
                       isValidId(code) &&
                       existing().ownerUid == request.auth.uid &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().code == existing().code &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['ownerName', 'updatedAt']) &&
                       isValidReferralCode(incoming());

      allow delete: if isSuperAdmin() && isValidId(code);
    }

    // ---- One-Time Referral Claims (+500 VC Welcome & Collectible Referrer Bonus) ----
    function isValidReferralClaim(data) {
      return data.referredUid is string && data.referredUid.size() >= 1 && data.referredUid.size() <= 128 &&
             data.referredName is string && data.referredName.size() >= 1 && data.referredName.size() <= 60 &&
             data.referrerUid is string && data.referrerUid.size() >= 1 && data.referrerUid.size() <= 128 &&
             data.referrerCode is string && data.referrerCode.size() >= 3 && data.referrerCode.size() <= 32 &&
             data.referrerName is string && data.referrerName.size() >= 1 && data.referrerName.size() <= 60 &&
             data.bonusCoins is int && data.bonusCoins == 500 &&
             data.referrerRewardClaimed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /referrals/{referredUid} {
      allow get: if isSignedIn() && isValidId(referredUid) && (
        isOwner(referredUid) || resource.data.referrerUid == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.referrerUid == request.auth.uid);

      allow create: if isOwner(referredUid) &&
                       isValidId(referredUid) &&
                       incoming().referredUid == request.auth.uid &&
                       incoming().referrerUid != request.auth.uid &&
                       incoming().bonusCoins == 500 &&
                       incoming().referrerRewardClaimed == false &&
                       exists(/databases/$(database)/documents/referral_codes/$(incoming().referrerCode)) &&
                       get(/databases/$(database)/documents/referral_codes/$(incoming().referrerCode)).data.ownerUid == incoming().referrerUid &&
                       incoming().keys().hasAll([
                         'referredUid', 'referredName', 'referrerUid', 'referrerCode',
                         'referrerName', 'bonusCoins', 'referrerRewardClaimed', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'referredUid', 'referredName', 'referrerUid', 'referrerCode',
                         'referrerName', 'bonusCoins', 'referrerRewardClaimed', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidReferralClaim(incoming());

      allow update: if isSignedIn() &&
                       isValidId(referredUid) &&
                       existing().referrerUid == request.auth.uid &&
                       existing().referrerRewardClaimed == false &&
                       incoming().referrerRewardClaimed == true &&
                       incoming().referredUid == existing().referredUid &&
                       incoming().referrerUid == existing().referrerUid &&
                       incoming().referrerCode == existing().referrerCode &&
                       incoming().bonusCoins == existing().bonusCoins &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['referrerRewardClaimed', 'updatedAt']) &&
                       isValidReferralClaim(incoming());

      allow delete: if false;
    }
  }
}
